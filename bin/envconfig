#!/bin/bash

# setup lsstsw environment
#
# source this file from your ~/.bashrc or ~/.zshrc
#
# relative to <lsstsw>/bin/

print_error() {
  >&2 echo -e "$@"
}
# setup curl
run_curl() {
    _c=curl
    # Silent, show errors
    _opt="-sS"
    # Use /usr/bin/curl if available for consistency
    [ -x /usr/bin/curl ] && _c=/usr/bin/curl
    # If running interactively, output progress
    [ -t 1 ] && _opt="-#"
    # Fail on error, follow redirects, and retry on transient errors
    $_c -fL --retry 3 $_opt "$@"
}

# Copy postinstall
copy_postinstall_fix(){
  callback_folder="$EUPS_PATH/site"
  hook="distribInstallPostHook.py"
  echo "Check to see if $callback_folder/$hook exists"
  hook_url="https://raw.githubusercontent.com/RobertLuptonTheGood/eups/refs/heads/master/callbacks/$hook"
  if [ ! -f "$callback_folder/$hook" ]; then
    echo "Installing posthook"
    run_curl -o "$callback_folder/$hook" "$hook_url"
  fi
}

usage() {
  if [[ -n "$1" ]]; then
    print_error "$0: $1"
  fi

  # note that heredocs are prefixed with tab chars
  (cat <<-EOF

		Usage: $0  [-i] [-n] [-b] [-h]

		Specific options:
	-i          interactive, choose from a list of available environments
	-n NAME     activate the environment name
	-b bXXXX    activate the environment used for the build with id bXXXX
	-h          show this message

		EOF
  )

  finish=true

}

parse_args() {
  local OPTIND
  local opt

  while getopts "b:n:ih" opt; do
    case "$opt" in
    b)
      BUILD_ID=${OPTARG}
      ;;
    n)
      ENV_NAME=${OPTARG}
      ;;
    i)
      INTERACTIVE=true
      ;;
    h)
      usage
      ;;
    *)
      usage "Unknown option: ${opt}"
      ;;
    esac
  done
  shift $((OPTIND-1))
}

##############

INTERACTIVE=false
ENV_NAME=""
BUILD_ID=""
finish=false

parse_args "$@"

if [ "$finish" = true ]; then
  return
fi

if [[ -n $BASH_VERSION ]]; then
  LSSTSW=$(cd "$(dirname "${BASH_SOURCE[0]}")/.."; pwd) || return 1
  SUFFIX='sh'
else
  LSSTSW=$(cd "$(dirname "$0")/.."; pwd) || return 1
  # shellcheck disable=SC2034
  SUFFIX='zsh'
fi

# shellcheck source=./etc/settings.cfg.sh
source "${LSSTSW}/etc/settings.cfg.sh"

# shellcheck disable=SC1091
. "${miniconda_path}/etc/profile.d/conda.sh"

export PATH="$LSSTSW/bin:$PATH"

if $INTERACTIVE ; then
  # get the list of available environments
  envs=()
  l=0
  for env in $(conda env list | grep -v "^[# ]" | cut -d' ' -f1); do
    if [[ "$env" != '' ]] && [[ "$env" != "base" ]] ; then
      ((l++))
      envs[l]="$env"
      echo "${l} - ${envs[${l}]}"
    fi
  done
  echo "0 - EXIT (return)"
  if [ -n "$ZSH_VERSION" ]; then
    read -r "eid?Choose environment [0 to ${l}]: "
  else
    read -r -p "Choose environment [0 to ${l}]: " eid
  fi
  if  [[ "${eid}" -eq 0 ]] ; then
    return
  fi
  if [[ -z "${envs[${eid}]}" ]] ; then
    echo "User input error: ${eid} not in range."
    return
  else
    LSST_CONDA_ENV_NAME="${envs[${eid}]}"
  fi
elif [[ $ENV_NAME != "" ]]; then
  echo "Setting $ENV_NAME environment..."
  LSST_CONDA_ENV_NAME=${ENV_NAME}
elif [[ $BUILD_ID != "" ]]; then
  echo "Looking for the environment used in build ${BUILD_ID}..."
  # absolute so -b works when sourced from outside $LSSTSW, as CI does
  build_env="${LSSTSW_BUILD_DIR}/builds/${BUILD_ID}.env"
  if [[ -f $build_env ]]; then
    LSST_CONDA_ENV_NAME=$(grep 'environment_name' "$build_env" | cut -f 2 -d ' ')
    echo "Activating environment ${LSST_CONDA_ENV_NAME}"
  else
    echo "No build found with id ${BUILD_ID} at ${build_env}"
    return
  fi
else
  # in case no ref is given as parameter, attach the default SHA-1 to $SPLENV_BASE_NAME (lsst-scipipe)
  suffix=$([ "$LSST_ADD_RSP" = true ] && echo "-rsp" || echo "")
  # Must reproduce the name deploy built, including an experimental python pin.
  if [[ -n $LSST_PYTHON_PIN ]]; then
    suffix="${suffix}-py${LSST_PYTHON_PIN}"
    # This script exports LSST_CONDA_ENV_NAME, so re-sourcing after setting a
    # pin would otherwise reuse the name and activate the unpinned environment.
    if [[ -n $LSST_CONDA_ENV_NAME && $LSST_CONDA_ENV_NAME != *"${suffix}" ]]; then
      echo "Ignoring LSST_CONDA_ENV_NAME='${LSST_CONDA_ENV_NAME}': it does not" \
        "carry the python pin '${LSST_PYTHON_PIN}'.  Use -n to activate it" \
        "instead, or unset LSST_PYTHON_PIN."
      LSST_CONDA_ENV_NAME=""
    fi
  fi
  LSST_CONDA_ENV_NAME=${LSST_CONDA_ENV_NAME:-"${SPLENV_BASE_NAME}-${LSST_SPLENV_REF}${suffix}"}

  # The name above is derived, not looked up, so it may well not be installed:
  # after `deploy -y 3.14` the pin is not set in a fresh shell, so the name
  # loses its -py3.14 suffix and points at nothing.  Rather than hand conda a
  # name that cannot activate, see what is actually installed.  One call: conda
  # env list is slow enough to notice when envconfig runs from a shell rc file.
  conda_envs=$(conda env list | grep -v "^[# ]" | cut -d' ' -f1)
  if ! printf '%s\n' "$conda_envs" | grep -qxF "$LSST_CONDA_ENV_NAME"; then
    n=0
    found=""
    list=""
    while read -r env_name; do
      # Only the environments lsstsw manages: never auto-activate base,
      # eups-base, or a user's unrelated env.  case, not grep: env names carry
      # dots, which a regex would read as wildcards.
      case "$env_name" in "${SPLENV_BASE_NAME}-"*) ;; *) continue ;; esac
      # A requested -rsp/-py suffix narrows the field, so an explicitly stated
      # intent still wins; no suffix means no preference.
      if [[ -n $suffix && $env_name != *"$suffix" ]]; then
        continue
      fi
      n=$((n+1))
      found=$env_name
      list="${list}    ${env_name}"$'\n'
    done <<< "$conda_envs"

    if [[ $n -eq 1 ]]; then
      echo "notice: ${LSST_CONDA_ENV_NAME} is not installed; using the only" \
        "environment that is: ${found}"
      LSST_CONDA_ENV_NAME=$found
    elif [[ $n -eq 0 ]]; then
      print_error "error: ${LSST_CONDA_ENV_NAME} is not installed, and no" \
        "${SPLENV_BASE_NAME}-*${suffix} environment was found."
      print_error "  Run bin/deploy to install one."
      return 1
    else
      print_error "error: ${LSST_CONDA_ENV_NAME} is not installed. Candidates:"
      print_error "$list"
      print_error "  Choose one with:  . ${LSSTSW}/bin/envconfig -n NAME"
      print_error "  or interactively: . ${LSSTSW}/bin/envconfig -i"
      return 1
    fi
  fi
  echo "Setting the environment... ${LSST_CONDA_ENV_NAME}"
fi

# An unchecked activate used to fall through to the eups probe below, which
# then created an eups-base environment nobody asked for, made a stack
# directory for an environment that does not exist, and -- because
# $CONDA_PREFIX still pointed at whatever was active before -- reported
# success with EUPS_PATH aimed at an unrelated stack.
if ! conda activate "$LSST_CONDA_ENV_NAME"; then
  print_error "error: failed to activate conda environment '${LSST_CONDA_ENV_NAME}'"
  return 1
fi
export LSST_CONDA_ENV_NAME

# check if eups is not already available in the environment
# if not, make it available from a separate eups-base environment
if ! command -v eups > /dev/null; then
  echo "error: No eups found in the active environment ..."
  echo "  ... trying to use a stacked eups-base environment"
  conda deactivate
  if ! conda env list | grep "^eups-base " > /dev/null; then
    echo "::: Creating eups-base environment"
    conda create -y --name eups-base eups -c conda-forge
  fi
  conda activate eups-base
  conda activate --stack "$LSST_CONDA_ENV_NAME"
fi

# Define and check EUPS_PATH
export EUPS_PATH="${LSSTSW}/stack/${LSST_CONDA_ENV_NAME}"
export EUPS_ROOT="https://eups.lsst.cloud/stack"
export LSST_MINICONDA_VERSION=${LSST_MINICONDA_VERSION:-py38_4.9.2}
# The recompute below keys the eups stack on the rubin-env version so that
# environments sharing a version share one stack.  A python pin has to survive
# it: the stack's ups_db and the binaries installed under it are specific to the
# python ABI, so a pinned environment needs a stack of its own.  deploy appends
# the pin last, so it is the trailing "-py<major.minor[.patch]>" of a name it
# prefixed with $SPLENV_BASE_NAME; anything else keeps the shared stack.
python_suffix=""
case "$LSST_CONDA_ENV_NAME" in
  "${SPLENV_BASE_NAME}-"*-py[0-9]*)
    python_pin="${LSST_CONDA_ENV_NAME##*-py}"
    case "$python_pin" in
      *[!0-9.]* | .* | *. | *..* | *.*.*.*) ;;
      *.*) python_suffix="-py${python_pin}" ;;
    esac
    unset python_pin
    ;;
esac
rubin_env_version=$(find "$CONDA_PREFIX/conda-meta" -maxdepth 1 -name 'rubin-env-[0-9]*.json' -print -quit | sed -E 's|.*/rubin-env-([^-]+)-.*|\1|') \
  && export EUPS_PATH="${LSSTSW}/stack/${SPLENV_BASE_NAME}-${rubin_env_version}${python_suffix}"
if [ ! -d "$EUPS_PATH" ]; then
  mkdir -p "${EUPS_PATH}"/{site,ups_db}
  echo "::: Deploying manifest.remap"
  ln -sf "${LSSTSW}/etc/manifest.remap" "${EUPS_PATH}/site/manifest.remap"
  copy_postinstall_fix
fi
# This code is a copy from lsstinstall. We should look for a way to unify this code
platform="$(uname -s)"
cpu_arch="$(uname -m)"
echo "Platform: $platform-$cpu_arch"
if [[ "$platform" = "Linux" ]]; then
  if [[ "$cpu_arch" = "x86_64" ]]; then
    eups_platform="redhat/el7/conda-system/miniconda3-${LSST_MINICONDA_VERSION}-$rubin_env_version"
  elif [[ "$cpu_arch" = "aarch64" ]]; then
    eups_platform="redhat/el8-arm/conda-system/miniconda3-${LSST_MINICONDA_VERSION}-$rubin_env_version"
  fi

elif [[ "$platform" = "Darwin" ]]; then
  if [[ "$cpu_arch" = "x86_64" ]]; then
    eups_platform="osx/10.9/conda-system/miniconda3-${LSST_MINICONDA_VERSION}-$rubin_env_version"
  elif [[ "$cpu_arch" = "arm64" ]]; then
    eups_platform="osx/14-arm/conda-system/miniconda3-${LSST_MINICONDA_VERSION}-$rubin_env_version"
  fi
fi
if [[ -z $eups_platform ]]; then
  # `fail` lives in bin/utils.sh, which this script does not source.
  print_error "error: unable to identify OS or architecture: $platform-$cpu_arch"
  return 1
fi
echo "$eups_platform"
export EUPS_DISTRIB="${EUPS_ROOT}/${eups_platform}"
# The pkgroot path has no python component, so the binaries published under it
# are built for the python rubin-env selects.  Their extension modules are
# ABI-untagged and link no libpython, so a pinned interpreter would load them
# and then fail unpredictably.  rebuild reads this and builds from source.
if [[ -n $python_suffix ]]; then
  echo "Python-pinned environment: eups binary packages will not be fetched"
  export LSST_PYTHON_PINNED_ENV=true
else
  unset LSST_PYTHON_PINNED_ENV
fi
echo "EUPS_PATH set to ${EUPS_PATH}"
export RUBIN_EUPS_PATH="${EUPS_PATH}"

setup -r "$LSSTSW/lsst_build"

echo "notice: lsstsw tools have been set up."

# vim: tabstop=2 shiftwidth=2 expandtab
